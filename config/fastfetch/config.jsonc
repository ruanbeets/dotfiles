{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "CachyOS",
    "padding": {"right": 4}
  },
  "display": {
    "separator": "  ",
    "color": {"keys": "#D72AC0", "title": "#F6E72B", "output": "#E8E6EA"},
    "key": {"width": 12},
    "size": {"ndigits": 1}
  },
  "modules": [
    {"type": "title", "format": "{user-name}@{host-name}"},
    {"type": "separator", "string": "────────────────────────────"},
    {"type": "os", "key": "  SYSTEM", "format": "{name} {version}"},
    {"type": "kernel", "key": "  KERNEL"},
    {"type": "uptime", "key": "󰅐  UPTIME"},
    {"type": "de", "key": "󰍹  DESKTOP"},
    {"type": "wm", "key": "󰖲  COMPOSITOR"},
    {"type": "terminal", "key": "  TERMINAL"},
    {"type": "shell", "key": "󰆍  SHELL"},
    {"type": "cpu", "key": "  CPU", "format": "{name}"},
    {"type": "gpu", "key": "󰢮  GPU", "format": "{name}", "hideType": "integrated"},
    {"type": "memory", "key": "  MEMORY"},
    {"type": "disk", "key": "󰋊  ROOT", "folders": "/"},
    {"type": "localip", "key": "󰩟  NETWORK", "showIpv4": true, "showIpv6": false, "showMac": false}
  ]
}
