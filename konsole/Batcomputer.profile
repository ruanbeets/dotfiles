[General]
Name=Batcomputer
Parent=FALLBACK/
Command=/usr/bin/fish
Icon=utilities-terminal
LocalTabTitleFormat=%d : %n
RemoteTabTitleFormat=%h : %d
TerminalColumns=120
TerminalRows=32
TerminalMargin=6
StartInCurrentSessionDir=true

[Appearance]
Font=JetBrainsMono Nerd Font,10.5,-1,5,400,0,0,0,0,0
ColorScheme=Batcomputer
AntiAliasFonts=true
BoldIntense=false

[Scrolling]
HistoryMode=1
HistorySize=20000
ScrollBarPosition=2

[Terminal Features]
BlinkingCursorEnabled=false
BlinkingTextEnabled=false

[Cursor Options]
CursorShape=1
UseCustomCursorColor=true
CustomCursorColor=54,207,224

[Interaction Options]
TrimTrailingSpacesInSelectedText=true
